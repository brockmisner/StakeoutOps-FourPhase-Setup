# Public Supabase browser configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key used by the Railway worker and integration routes.
SUPABASE_SECRET_KEY=

# 32-byte key encoded as base64. Generate with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=

# Production v1 uses the proxy already configured on each phone. Leave this
# false (or unset) and leave the key empty; neither variable is required to launch.
PROXY_SELLER_AUTOMATION_ENABLED=false
# Future managed-proxy opt-in only. This provider embeds the key in request URLs,
# so if the feature is ever enabled, keep the key server-only and never log full URLs.
PROXY_SELLER_API_KEY=

# Random value of at least 32 characters for authenticated manual tick requests.
CRON_SECRET=

# Optional behavior tuning.
DUOPLUS_BASE_URL=https://openapi.duoplus.net
DUOPLUS_MIN_GAP_MS=1200
# IANA timezone used when a new connection serializes DuoPlus issue_at values.
# Keep UTC until the two-minute manual probe confirms the account's behavior.
DUOPLUS_ISSUE_TIMEZONE=UTC
DISPATCH_LOOKAHEAD_MINUTES=15
DISPATCH_BATCH_SIZE=20
HORIZON_DISPATCH_BATCH_SIZE=100
# Local default only. Override Production with https://stakeout-ops.vercel.app.
# Supabase Auth's separate Site URL and Redirect URLs must also be configured;
# this variable cannot override a localhost URL stored in the Supabase dashboard.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Fail-closed public signup UI. Leave false for invitation-only deployments.
NEXT_PUBLIC_ALLOW_SIGNUPS=false

# Explicitly opt in only for a read-only UI preview without Supabase credentials.
# Use false for every working Preview and Production deployment.
NEXT_PUBLIC_DEMO_MODE=true

# Railway worker: SUPABASE_URL may replace NEXT_PUBLIC_SUPABASE_URL there.
# Also set SUPABASE_SECRET_KEY, the SAME INTEGRATION_ENCRYPTION_KEY as Vercel,
# and NEXT_PUBLIC_DEMO_MODE=false. Never run a worker on a demo environment.
WORKER_INTERVAL_MS=30000
WORKER_TICK_BUDGET_MS=90000
WORKER_STALE_AFTER_MS=600000
